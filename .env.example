# Copy this to .env and fill in the real value. Never commit .env itself.
#
# Generate a reusable, tagged auth key at:
#   https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=<paste the real generated Tailscale auth key here>

# Optional -- what this container's node shows up as in your tailnet.
# Deliberately distinct from tcg-price-tracker's own hostname.
TS_HOSTNAME=nekocti

# Optional -- a free NVD API key (https://nvd.nist.gov/developers/request-an-api-key).
# Raises the CVE-severity lookup rate limit from 5 requests per 30s to 50.
# `main.py enrich` works without it, just slower.
NVD_API_KEY=<paste your NVD API key here, or leave unset>
