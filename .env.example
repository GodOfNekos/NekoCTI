# Copy this to .env and fill in what you need. Never commit .env itself.

# Optional -- a free NVD API key (https://nvd.nist.gov/developers/request-an-api-key).
# Raises the CVE-severity lookup rate limit from 5 requests per 30s to 50.
# `main.py enrich` works without it, just slower.
# NVD_API_KEY=

# Optional -- a GitHub token (a fine-grained one with no permissions is enough:
# it only reads public data). Raises the GitHub API limit for the advisories,
# PoC and coverage listings from 60 requests an hour to 5,000.
# GITHUB_TOKEN=

# Optional -- the folder holding your daily notes (YYYY-MM-DD.md), which the
# digest appends to. Defaults to ./digest-notes next to docker-compose.yml.
# DIGEST_NOTES_DIR=/path/to/your/daily-notes

# Optional -- where today's note sits inside that folder, as a strftime
# pattern. Unset means flat (2026-10-21.md). For month folders like
# "10 - October 2026/2026-10-21.md":
# DIGEST_NOTE_PATTERN=%m - %B %Y/%Y-%m-%d.md

# Optional -- for a second instance on the same machine: its own container
# name and loopback port (the dashboard is then http://127.0.0.1:<port>/).
# NEKOCTI_NAME=nekocti
# NEKOCTI_PORT=8778

# Optional -- where Ollama runs, for ATT&CK classification.
# OLLAMA_URL=http://host.docker.internal:11434

# Optional -- the time zone for the digest's note name and heading.
# TZ=Europe/London
